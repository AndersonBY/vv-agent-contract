      "required_fields": [
        "trigger_ratio",
        "target_ratio",
        "keep_recent_cycles",
        "min_result_chars"
      ]
    },
    "single_plan_and_apply_pass_per_cycle": true,
    "candidate_required_for_micro_lifecycle_event": true,
    "task_semantics_are_not_inspected": true,
    "tool_name_allowlist": false,
    "result_retention": {
      "default": "archive",
      "values": [
        "archive",
        "preserve"
      ],
      "preserve_applies_to": "proactive_microcompaction_only"
    },
    "archive": {
      "required_before_replacement": true,
      "logical_path_prefix": ".vv-agent/artifacts/",
      "persistence_failure": "preserve_original_message",
      "existing_artifact": "reuse"
    },
    "model_visible_marker": {
      "opening": "<Tool Result Compact>",
      "closing": "</Tool Result Compact>",
      "field_order": [
        "tool_name",
        "artifact_path",
        "retrieval_hint",
        "excerpt"
      ],
      "retrieval_hint": "use read_file on artifact_path if needed",
      "forbidden_fields": [
        "original_bytes",
        "visible_bytes",
        "size_bytes",
        "sha256",
        "total_chars",
        "truncated_chars"
      ],
      "example": "<Tool Result Compact>\ntool_name: web_search\nartifact_path: .vv-agent/artifacts/run-7/call-search.txt\nretrieval_hint: use read_file on artifact_path if needed\nexcerpt:\nfirst result\n...<snip>...\nlast result\n</Tool Result Compact>"
    },
    "cases": [
      {
        "name": "below_minimum",
        "tool_name": "custom_search",
        "result_retention": "archive",
        "repeat": 300,
        "replaced_with_compact_marker": false
      },
      {
        "name": "at_minimum",
